# Copy this file to .env and fill in only the integrations you plan to use.
# Never commit .env or put server credentials in Frontend/.env.local.

# Local API settings
PORT=8080
# Comma-separated browser origins. Add the exact deployed frontend origin in production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional data folder override for isolated environments; keep local data out of Git.
DATA_DIR=

# Required only for Nemo AI chat; keep this credential server-side.
GEMINI_API_KEY=

# Optional PostgreSQL; leave blank to use Backend/mock-server/data/enrollments.json
DATABASE_URL=

# Optional Salesforce CRM sync for inquiry leads and counselor handoffs
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_MY_DOMAIN=

# Optional Twilio WhatsApp messaging
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Counselor-only routes remain disabled until all three values are configured.
# JWT_SECRET must be a unique random value of at least 32 characters.
JWT_SECRET=
COUNSELOR_USERNAME=
COUNSELOR_PASSWORD=
